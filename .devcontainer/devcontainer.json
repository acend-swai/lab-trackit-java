{
  "name": "trackit",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "21" },
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "forwardPorts": [8080, 5173, 5432],
  "portsAttributes": {
    "8080": { "label": "TrackIt backend", "onAutoForward": "notify" },
    "5173": { "label": "TrackIt frontend", "onAutoForward": "openBrowser" },
    "5432": { "label": "TrackIt database", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-boot-dev-pack",
        "Vue.volar",
        "Anthropic.claude-code",
        "GitHub.copilot"
      ]
    }
  }
}
