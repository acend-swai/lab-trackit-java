# Copy to .env - your personal file arrives by mail on the workshop morning.
# .env is in .gitignore. Keep it that way.

# Claude Code talks to the Anthropic API directly. There is no gateway in front
# of it. If you have your own Claude Code licence, log in with your account and
# leave this empty - a key set here overrides your subscription. If you have no
# licence, put the key from your mail here.
ANTHROPIC_API_KEY=

# OpenRouter key for OpenCode, starts with sk-or-v1-. OpenCode does not read
# this file: store the key once with /connect inside OpenCode. Kept here so both
# keys arrive in one place.
OPENROUTER_API_KEY=
